# Names only, never values (#31). Generated from scripts/lib/envCatalog.js by
# `npm run generate:env-docs`; edit the catalog, not this file.
#
# The master .env.local lives in the main checkout only; worktrees read it from there.
# Where each name belongs: docs/SECRETS-AND-ENVIRONMENT.md

# Spotify OAuth
# Spotify app client id for the OAuth login and API calls (required)
SPOTIFY_CLIENT_ID=
# Spotify app client secret for the token exchange and refresh (required, secret)
SPOTIFY_CLIENT_SECRET=
# OAuth callback URL registered with Spotify; differs per environment (required)
SPOTIFY_REDIRECT_URI=
# Public base URL of the app; differs per environment (required)
NEXT_PUBLIC_BASE_URL=

# Analytics and error tracking
# Umami website id; analytics are off when unset (inlined at build time) (required)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Sentry DSN for browser and server error reports; Sentry is off when unset (optional)
NEXT_PUBLIC_SENTRY_DSN=
# Server-only Sentry DSN override; falls back to NEXT_PUBLIC_SENTRY_DSN (optional)
SENTRY_DSN=
# Sentry organisation slug for the source-map upload at build time (optional)
SENTRY_ORG=
# Sentry project slug for the source-map upload at build time (optional)
SENTRY_PROJECT=
# Sentry token for the source-map upload at build time (optional, secret)
SENTRY_AUTH_TOKEN=

# Database (Neon integration)
# Pooled Neon Postgres connection string used by the app (required, secret)
DATABASE_URL=
# Direct Neon Postgres connection string for migrations (required, secret)
DATABASE_URL_UNPOOLED=
# Database query log level (default info) (optional)
DB_LOG_LEVEL=
# Slow-query log threshold in milliseconds (default 500) (optional)
DB_SLOW_QUERY_MS=

# BPM service (Cloud Run)
# BPM/key analysis service on Cloud Run (delman-site) (required)
BPM_SERVICE_URL=
# Single-line JSON key of vercel-bpm-invoker, which may invoke the BPM service (required, secret)
GCP_SERVICE_ACCOUNT_KEY=
# Tracks per BPM streaming batch (default 5) (optional)
BPM_STREAM_BATCH_SIZE=

# Deploy (Vercel Blob integration)
# Vercel Blob token; the deploy keeps its manifest there (required, secret)
BLOB_READ_WRITE_TOKEN=
# Blob path of the deploy manifest (default deployment-manifests/spotify-playlist-browser.json) (optional)
DEPLOY_MANIFEST_BLOB_PATH=

# Optional tuning and links
# Playlist cache lifetime in milliseconds (optional)
PLAYLIST_CACHE_TTL_MS=
# Parallel Spotify follower-count requests (optional)
SPOTIFY_FOLLOWERS_CONCURRENCY=
# Server log level (default info) (optional)
LOG_LEVEL=
# Link on the admin observability page (has a generic default) (optional)
VERCEL_DASHBOARD_URL=
# Link on the admin observability page (has a generic default) (optional)
GCP_LOGS_URL=
# Link on the admin observability page (has a generic default) (optional)
GCP_METRICS_URL=
# Link on the admin observability page (has a generic default) (optional)
SENTRY_DASHBOARD_URL=
