{
  "mcpServers": {
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "gcloud-observability": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@google-cloud/observability-mcp"
      ],
      "env": {}
    },
    "gcloud": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@google-cloud/gcloud-mcp"
      ],
      "env": {}
    }
  }
}